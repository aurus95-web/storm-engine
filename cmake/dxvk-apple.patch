 namespace dxvk {
 
+  /**
+   * \brief Checks whether vertex strides can be dynamic
+   *
+   * MoltenVK reports Vulkan 1.3, but Metal only supports dynamic vertex
+   * strides on macOS 14 and iOS 17, pipelines using them fail to compile
+   * on older systems. Strides are baked into the pipeline state there.
+   */
+  inline bool dynamicVertexStridesSupported() {
+#ifdef __APPLE__
+    static const bool supported = [] {
+      char version[32] = { };
+      size_t size = sizeof(version) - 1;
+      int major = 0;
+
+      if (sysctlbyname("kern.osproductversion", version, &size, nullptr, 0) == 0)
+        major = std::atoi(version);
+
+#if TARGET_OS_IPHONE
+      return major >= 17;
+#else
+      return major >= 14;
+#endif
+    }();
+
+    return supported;
+#else
+    return true;
+#endif
+  }
+
