# Third-party dependencies without Conan.
#
# Used for platforms where Conan packages are not available (macOS, iOS) and as an
# alternative on Linux. Every dependency is fetched from its git repository and exposed
# under the same target name the Conan-based build provides, so module CMakeLists.txt
# files do not need to know which mode is used.

include(FetchContent)

### Build watermark (generated by conanfile.py in the Conan build)
find_package(Git QUIET)
set(storm_watermark "unknown")
if (GIT_FOUND)
    execute_process(COMMAND ${GIT_EXECUTABLE} rev-parse --abbrev-ref HEAD
        WORKING_DIRECTORY ${CMAKE_SOURCE_DIR} OUTPUT_VARIABLE storm_git_branch
        OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    execute_process(COMMAND ${GIT_EXECUTABLE} rev-parse HEAD
        WORKING_DIRECTORY ${CMAKE_SOURCE_DIR} OUTPUT_VARIABLE storm_git_commit
        OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if (storm_git_commit)
        set(storm_watermark "${storm_git_branch}(${storm_git_commit})")
    endif()
endif()
file(WRITE ${STORM_WATERMARK_FILE} "#pragma once\n#define STORM_BUILD_WATERMARK ${storm_watermark}\n")

set(FETCHCONTENT_QUIET OFF)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)

macro(storm_fetch name repository tag)
    FetchContent_Declare(${name}
        GIT_REPOSITORY ${repository}
        GIT_TAG ${tag}
        GIT_SHALLOW ON
        GIT_SUBMODULES ""
        ${ARGN}
    )
endmacro()

### zlib (part of the system SDK on Apple platforms)
find_package(ZLIB REQUIRED)
add_library(zlib INTERFACE)
target_link_libraries(zlib INTERFACE ZLIB::ZLIB)

### fmt (used directly by the engine, so spdlog is built against the external one)
storm_fetch(fmt https://github.com/fmtlib/fmt.git 10.2.1)

### spdlog
set(SPDLOG_FMT_EXTERNAL ON CACHE BOOL "" FORCE)
set(SPDLOG_BUILD_EXAMPLE OFF CACHE BOOL "" FORCE)
set(SPDLOG_INSTALL OFF CACHE BOOL "" FORCE)
storm_fetch(spdlog https://github.com/gabime/spdlog.git v1.13.0)

### fast_float
storm_fetch(fast_float https://github.com/fastfloat/fast_float.git v8.0.2)

### toml++
storm_fetch(tomlplusplus https://github.com/marzer/tomlplusplus.git v3.3.0)

### nlohmann_json
set(JSON_BuildTests OFF CACHE BOOL "" FORCE)
set(JSON_Install OFF CACHE BOOL "" FORCE)
storm_fetch(nlohmann_json https://github.com/nlohmann/json.git v3.11.2)

### CLI11
set(CLI11_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(CLI11_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
set(CLI11_BUILD_DOCS OFF CACHE BOOL "" FORCE)
storm_fetch(cli11 https://github.com/CLIUtils/CLI11.git v2.3.2)

### Microsoft GSL
set(GSL_TEST OFF CACHE BOOL "" FORCE)
set(GSL_INSTALL OFF CACHE BOOL "" FORCE)
storm_fetch(gsl https://github.com/microsoft/GSL.git v4.1.0)

### Dear ImGui (no CMake support upstream)
storm_fetch(imgui https://github.com/ocornut/imgui.git v1.90-docking)

# imgui has no CMakeLists.txt, so it is only downloaded here
FetchContent_MakeAvailable(fmt spdlog fast_float tomlplusplus nlohmann_json cli11 gsl imgui)

add_library(imgui STATIC
    ${imgui_SOURCE_DIR}/imgui.cpp
    ${imgui_SOURCE_DIR}/imgui_demo.cpp
    ${imgui_SOURCE_DIR}/imgui_draw.cpp
    ${imgui_SOURCE_DIR}/imgui_tables.cpp
    ${imgui_SOURCE_DIR}/imgui_widgets.cpp
)
target_include_directories(imgui PUBLIC ${imgui_SOURCE_DIR})
add_library(imgui::imgui ALIAS imgui)
set(ImGui_FOUND TRUE)

# the Conan recipe copies these bindings into the build folder (see conanfile.py)
foreach (binding imgui_impl_sdl2.cpp imgui_impl_sdl2.h)
    configure_file(${imgui_SOURCE_DIR}/backends/${binding} ${CMAKE_BINARY_DIR}/imgui/${binding} COPYONLY)
endforeach()
foreach (misc imgui_stdlib.cpp imgui_stdlib.h)
    configure_file(${imgui_SOURCE_DIR}/misc/cpp/${misc} ${CMAKE_BINARY_DIR}/imgui/${misc} COPYONLY)
endforeach()

### Catch2
if (STORM_BUILD_TESTS)
    storm_fetch(catch2 https://github.com/catchorg/Catch2.git v3.9.1)
    FetchContent_MakeAvailable(catch2)
endif()

### SDL2
if (STORM_FETCH_SDL)
    set(SDL_SHARED OFF CACHE BOOL "" FORCE)
    set(SDL_STATIC ON CACHE BOOL "" FORCE)
    set(SDL_TEST OFF CACHE BOOL "" FORCE)
    set(SDL2_DISABLE_INSTALL ON CACHE BOOL "" FORCE)
    storm_fetch(sdl2 https://github.com/libsdl-org/SDL.git release-2.32.2)
    FetchContent_MakeAvailable(sdl2)

    # sources include SDL as <SDL2/SDL.h>
    set(STORM_SDL_INCLUDE_ROOT ${CMAKE_BINARY_DIR}/sdl2-include)
    file(MAKE_DIRECTORY ${STORM_SDL_INCLUDE_ROOT})
    file(CREATE_LINK ${sdl2_SOURCE_DIR}/include ${STORM_SDL_INCLUDE_ROOT}/SDL2 SYMBOLIC)
    target_include_directories(SDL2-static INTERFACE $<BUILD_INTERFACE:${STORM_SDL_INCLUDE_ROOT}>)

    set(SDL2_LIBRARIES SDL2::SDL2-static)
    if (TARGET SDL2::SDL2main)
        list(APPEND SDL2_LIBRARIES SDL2::SDL2main)
    endif()
else()
    find_package(SDL2 REQUIRED)
    set(SDL2_LIBRARIES SDL2::SDL2)
endif()

### FMOD (proprietary, has to be downloaded from fmod.com)
add_library(fmod_sdk INTERFACE)
add_library(fmod::fmod ALIAS fmod_sdk)
if (STORM_FMOD_DIR)
    set(fmod_core "${STORM_FMOD_DIR}/api/core")
    target_include_directories(fmod_sdk INTERFACE "${fmod_core}/inc")
    if (IOS)
        if (CMAKE_OSX_SYSROOT MATCHES "[Ss]imulator")
            set(fmod_lib "${fmod_core}/lib/libfmod_iphonesimulator.a")
        else()
            set(fmod_lib "${fmod_core}/lib/libfmod_iphoneos.a")
        endif()
        target_link_libraries(fmod_sdk INTERFACE "${fmod_lib}"
            "-framework AudioToolbox" "-framework AVFoundation" "-framework CoreAudio")
    elseif (APPLE)
        target_link_libraries(fmod_sdk INTERFACE "${fmod_core}/lib/libfmod.dylib")
    else()
        target_link_libraries(fmod_sdk INTERFACE "${fmod_core}/lib/${CMAKE_SYSTEM_PROCESSOR}/libfmod.so")
    endif()
endif()

### DirectX: headers come from DXVK (see apple.cmake / linux.cmake)
