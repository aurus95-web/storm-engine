# Meson cross file for building DXVK for iOS devices (arm64) on a macOS host.
# Configured by cmake/apple.cmake.

[binaries]
c = 'clang'
cpp = 'clang++'
objc = 'clang'
objcpp = 'clang++'
ar = 'ar'
strip = 'strip'
pkg-config = 'pkg-config'

[host_machine]
system = 'darwin'
cpu_family = 'aarch64'
cpu = 'arm64'
endian = 'little'

[built-in options]
c_args = ['-arch', 'arm64', '-isysroot', '@storm_apple_sdk@', '-miphoneos-version-min=@storm_min_version@']
cpp_args = ['-arch', 'arm64', '-isysroot', '@storm_apple_sdk@', '-miphoneos-version-min=@storm_min_version@']
c_link_args = ['-arch', 'arm64', '-isysroot', '@storm_apple_sdk@', '-miphoneos-version-min=@storm_min_version@']
cpp_link_args = ['-arch', 'arm64', '-isysroot', '@storm_apple_sdk@', '-miphoneos-version-min=@storm_min_version@']
